# Set to "true" to use frozen mock data (docs/samples-derived) instead of a
# live backend. Useful before the backend is deployed, or for offline demos.
NEXT_PUBLIC_USE_MOCK=true

# Base URL of the Sky-to-Soil backend (FastAPI). Ignored when
# NEXT_PUBLIC_USE_MOCK=true.
NEXT_PUBLIC_API_URL=http://localhost:8000
