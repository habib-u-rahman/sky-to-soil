# Copy to .env and fill in real values. Never commit the real .env file.

# Groq API key, used by the AI Agronomist (app/advisor/) for POST /advisor/explain
# and POST /advisor/chat, and by backend/scripts/eval_advisor.py and
# app/scripts/build_demo.py. Not required to serve ?demo=true afterwards --
# only to generate/regenerate it, or to use the advisor endpoints live.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Comma-separated extra CORS origins to allow, beyond localhost:3000-3005
# (always allowed, for local dev) and any https://*.vercel.app origin
# (always allowed via a separate regex-matching middleware in app/main.py,
# which covers both your production Vercel URL and every preview deploy
# automatically). You only need to set this if you add a custom domain,
# e.g. EXTRA_CORS_ORIGINS=https://your-custom-domain.com
EXTRA_CORS_ORIGINS=

# Set to "true" to log full upstream request/response bodies (debug only)
S2S_DEBUG=false
